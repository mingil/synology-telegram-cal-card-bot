# ==========================================
# 🤖 Telegram Bot Configuration (Required)
# ==========================================
# Your Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID / Admin ID (check via @userinfobot)
TARGET_CHAT_ID=123456789

# ==========================================
# 🧠 AI Service Configuration (Optional)
# ==========================================
# Google Gemini API Key (from Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model name (default: gemini-3.6-flash)
AI_MODEL_NAME=gemini-3.6-flash

# ==========================================
# 🔐 Security & Authentication
# ==========================================
# Password required for initial bot access by new users
BOT_PASSWORD=secret_password

# Comma-separated list of User IDs that bypass password authentication
# Note: TARGET_CHAT_ID is automatically included as a trusted admin user.
TRUSTED_USER_IDS=123456789,987654321

# ==========================================
# 📅 Synology Calendar (CalDAV)
# ==========================================
# Calendar URL (Include the trailing slash '/')
CALDAV_URL=https://your-nas-url/caldav.php/username/
CALDAV_USERNAME=your_synology_id
CALDAV_PASSWORD=your_synology_password

# Optional: Filter by a specific calendar name (leave empty to query all calendars)
CALENDAR_NAME=

# ==========================================
# 👤 Synology Contacts (CardDAV)
# ==========================================
# Contacts URL (Copy from Synology Contacts settings)
CARDDAV_URL=https://your-nas-url/carddav/username/uuid-string
CARDDAV_USERNAME=your_synology_id
CARDDAV_PASSWORD=your_synology_password

# ==========================================
# 📧 Email Notification (SMTP) Settings (Optional)
# ==========================================
# e.g., smtp.gmail.com (Google) / smtp.naver.com (Naver)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email address to send and receive notifications (leave empty to disable email alerts)
SMTP_EMAIL=your_email@gmail.com

# IMPORTANT: Use an 'App Password' (2FA), NOT your regular account password
SMTP_PASSWORD=your_app_password

# ==========================================
# ⏰ Schedule & System Settings
# ==========================================
# Timezone (default: Asia/Seoul)
TZ=Asia/Seoul

# Daily notification time (24-hour format, default: 07:00)
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Synology NAS user/group ID mapping for volume permissions
PUID=1026
PGID=100
