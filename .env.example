# ==========================================
# 🤖 Telegram Bot Configuration
# ==========================================
# Your Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (check via @userinfobot)
TARGET_CHAT_ID=123456789

# ==========================================
# 🧠 AI Service Configuration
# ==========================================
# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# 🔐 Security & Authentication
# ==========================================
# Password required for initial bot access
BOT_PASSWORD=secret_password

# Comma-separated list of User IDs that bypass authentication
TRUSTED_USER_IDS=123456789,987654321

# ==========================================
# 📅 Synology Calendar (CalDAV)
# ==========================================
# Calendar URL (Include the trailing slash '/')
CALDAV_URL=https://your-nas-url/caldav.php/username/
CALDAV_USERNAME=your_synology_id
CALDAV_PASSWORD=your_synology_password

# ==========================================
# 👤 Synology Contacts (CardDAV)
# ==========================================
# Contacts URL (Copy from Synology Contacts settings)
CARDDAV_URL=https://your-nas-url/carddav/username/uuid-string
CARDDAV_USERNAME=your_synology_id
CARDDAV_PASSWORD=your_synology_password

# ==========================================
# ⚙️ System Settings
# ==========================================
# Timezone
TZ=Asia/Seoul

# ==========================================
# 📧 Email Notification (SMTP) Settings
# ==========================================
# e.g., smtp.gmail.com (Google) / smtp.naver.com (Naver)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email address to send and receive notifications
SMTP_EMAIL=your_email@gmail.com

# IMPORTANT: Use an 'App Password' (2FA), NOT your actual account password
SMTP_PASSWORD=your_app_password

# ==========================================
# ⏰ Schedule Settings
# ==========================================
# Daily notification time (24-hour format)
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
